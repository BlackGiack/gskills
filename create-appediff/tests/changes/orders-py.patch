new file mode 100644
index 0000000..a7c88b6
--- /dev/null
+++ b/orders/events/bus.py
@@ -0,0 +1,15 @@
+"""Events other parts of the system react to."""
+
+
+class EventBus:
+    """Delivers order events to subscribers, in order."""
+
+    def __init__(self) -> None:
+        self.subscribers = []
+
+    def subscribe(self, handler) -> None:
+        self.subscribers.append(handler)
+
+    def publish(self, name: str, order_id: str) -> None:
+        for handler in self.subscribers:
+            handler(name, order_id)
